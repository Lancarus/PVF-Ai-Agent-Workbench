{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pvf-agent-workbench/schemas/pvf-lineage-catalog.schema.json",
  "type": "object",
  "required": ["schemaVersion", "phase", "summary", "versions", "transitions", "goldenCases", "safety"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "phase": { "const": "pvf-semantic-lineage" },
    "versions": { "type": "array", "minItems": 2 },
    "transitions": { "type": "array", "minItems": 1 },
    "goldenCases": { "type": "object", "required": ["superArmorOnCast", "bloodSwordDerivative"] },
    "safety": { "type": "object", "required": ["readOnly", "fullShaIsVersionKey", "generatedIndexesAreFinalEvidence"] }
  }
}
