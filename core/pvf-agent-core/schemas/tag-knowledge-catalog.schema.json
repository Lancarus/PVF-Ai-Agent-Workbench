{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pvf-agent-workbench/schemas/tag-knowledge-catalog.schema.json",
  "type": "object",
  "required": ["schemaVersion", "phase", "summary", "community", "layeredTags", "registryHints", "safety"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "phase": { "const": "external-pvf-tag-catalog" },
    "summary": {
      "type": "object",
      "required": ["oldRowCount", "newRowCount", "addedIdCount", "removedIdCount", "substantiveChangedCount", "officialOriginalTagCount", "toolExtensionOnlyTagCount"]
    },
    "community": { "type": "object", "required": ["sources", "summary", "newRows", "diff"] },
    "layeredTags": { "type": "object", "required": ["sources", "summary", "files", "tags"] },
    "registryHints": { "type": "object", "required": ["entries", "suspiciousRegistryCandidates"] },
    "safety": { "type": "object", "required": ["localResearchOnly", "translationNeverOverwritesOriginal", "toolExtensionSeparatedFromOfficialOriginal"] }
  }
}
